{
  "name": "azdo-pipeline-emulator",
  "version": "0.0.0",
  "private": true,
  "description": "Convert Azure DevOps YAML pipelines into self-contained local bash projects",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm run test:unit && pnpm run test:bats",
    "test:unit": "vitest run --coverage",
    "test:bats": "pnpm --filter @azdo-emu/runtime run test",
    "typecheck": "tsc --noEmit -p tsconfig.meta.json && tsc --noEmit -p scripts && pnpm -r run typecheck",
    "refresh-schema": "node scripts/refresh-schema.ts",
    "oracle-probe": "node scripts/oracle-probe.ts",
    "oracle-quirks": "node scripts/oracle-quirks.ts",
    "org-schema": "node scripts/org-schema.ts",
    "oracle-provision": "node scripts/oracle-provision.ts",
    "corpus-probe": "node scripts/corpus-probe.ts",
    "corpus-oracle": "node scripts/corpus-oracle.ts",
    "normalizer-survey": "node scripts/normalizer-survey.ts",
    "expr-grammar-survey": "node scripts/expr-grammar-survey.ts",
    "expr-error-survey": "node scripts/expr-error-survey.ts",
    "expr-bare-function-survey": "node scripts/expr-bare-function-survey.ts",
    "expr-coercion-survey": "node scripts/expr-coercion-survey.ts",
    "expr-member-survey": "node scripts/expr-member-survey.ts",
    "expr-logical-survey": "node scripts/expr-logical-survey.ts",
    "expr-status-survey": "node scripts/expr-status-survey.ts",
    "expr-status-realrun": "node scripts/expr-status-realrun.ts",
    "expr-general-survey": "node scripts/expr-general-survey.ts",
    "expr-filtered-array-survey": "node scripts/expr-filtered-array-survey.ts",
    "expr-context-survey": "node scripts/expr-context-survey.ts",
    "expr-resources-realrun": "node scripts/expr-resources-realrun.ts",
    "template-walk-survey": "node scripts/template-walk-survey.ts",
    "each-survey": "node scripts/each-survey.ts",
    "if-survey": "node scripts/if-survey.ts",
    "template-conditionals-survey": "node scripts/template-conditionals-survey.ts",
    "insert-survey": "node scripts/insert-survey.ts",
    "interpolation-survey": "node scripts/interpolation-survey.ts",
    "reference-survey": "node scripts/reference-survey.ts",
    "bundle-survey": "node scripts/bundle-survey.ts",
    "template-parameters-survey": "node scripts/template-parameters-survey.ts",
    "normalization-survey": "node scripts/normalization-survey.ts",
    "strict-validation-survey": "node scripts/strict-validation-survey.ts",
    "expansion-provenance": "pnpm --filter @azdo-emu/engine build && node scripts/expansion-provenance.ts",
    "dependency-survey": "node scripts/dependency-survey.ts",
    "predefined-vars": "node scripts/predefined-vars.ts",
    "duplicate-key-survey": "node scripts/duplicate-key-survey.ts",
    "expr-shell-survey": "bash scripts/expr-shell-survey.sh",
    "expr-conformance-bats": "vitest run --project engine packages/engine/test/expr/conformance.test.ts -u",
    "lint": "pnpm run lint:es && pnpm run lint:format && pnpm run lint:shell",
    "lint:es": "eslint .",
    "lint:format": "prettier --check .",
    "lint:shell": "pnpm --filter @azdo-emu/runtime run lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
