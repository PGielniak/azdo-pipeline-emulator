#!/usr/bin/env bash
# Repo-managed pre-commit hook. Activate once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-verify-markers.sh" --staged
# The commit boundary is the right place for this one: the transcript that leaked an
# org name in base64 (C-E09-094) was untracked when it was written and clean to every
# literal-text check. Staged content is what is about to become public.
"$root/scripts/check-encoded-secrets.sh" --staged
