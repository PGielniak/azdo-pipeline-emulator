{
  "name": "@azdo-emu/cli",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "15.0.0",
    "yaml": "2.9.0"
  },
  "bin": {
    "azdo-emu": "./dist/bin.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
